# Copy to .env (repo root). Every variable is optional — anything missing falls back to a
# clearly labelled SIMULATED / DEMO ADAPTER / HEURISTIC mode. All keys stay server-side.

# ── Server ─────────────────────────────────────────────
HOST=127.0.0.1            # loopback by default; non-loopback requires ALLOW_PUBLIC_DEMO=true
PORT=4000
# ALLOW_PUBLIC_DEMO=true  # only if you knowingly expose the demo (its sign-in has no passwords)
# DATA_DIR=./server/data  # JSON store + evidence files
# PUBLIC_BASE_URL=https://your-app.onrender.com   # public origin so Kernel can reach /demo-store

# ── PayPal (Sandbox) ───────────────────────────────────
# developer.paypal.com → Apps & Credentials → Sandbox app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox       # sandbox | live
PAYPAL_WEBHOOK_ID=        # webhook pointing at https://<host>/webhooks/paypal (verification is mandatory)

# ── Kernel browser agent ───────────────────────────────
KERNEL_API_KEY=
# KERNEL_BASE_URL=https://api.onkernel.com/   # SDK default

# ── AI / vision provider (any one; first key present wins) ──
# AI_PROVIDER=groq          # pin a provider explicitly, else: anthropic > gemini > groq
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile    # text: SOW extraction, QA mediation, classification
# GROQ_VISION_MODEL=qwen/qwen3.8-27b    # auto-used for screenshot analysis (max 3 images/call)

# ── APIMatic (SDK generation from apimatic/src/spec/openapi.yaml) ──
APIMATIC_API_KEY=
